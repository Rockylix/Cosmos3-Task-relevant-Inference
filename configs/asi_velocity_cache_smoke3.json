{
  "strategy": "asi_velocity_cache_task_core_top7_global_stable",
  "task_core_top7": true,
  "tasks": [
    "BananaInBowlTask",
    "BananaOnPlateTask",
    "ButterAboveRaisinTask"
  ],
  "protocol": {
    "num_steps": 4,
    "shift": 5,
    "guidance": 3,
    "sampler": "unipc",
    "compile": false,
    "cuda_graphs": false,
    "policy_seed": 0,
    "simulator_seed": 0,
    "deterministic_seed": false,
    "reset_policy_rng_on_prompt_change": true,
    "format_prompt_as_json": true,
    "num_envs": 1,
    "rollouts_each": 1,
    "video_mode": "none"
  },
  "selection": {
    "core_tokens_per_future_frame": 80,
    "shared_stable_tokens": 104,
    "future_tokens_per_frame": 184,
    "core_source_layers": "task_first_chunk_top7",
    "stable_profile_layers": "all_28_every_chunk"
  },
  "velocity_cache": {
    "source": "step0 guided velocity from dense conditional and sparse unconditional",
    "scope": "request_local",
    "reuse_steps": [1, 2, 3],
    "reuse_region": "removed future vision coordinates only"
  },
  "usage": "Copy to a fresh eval_root/manifest.json; pass --task-core-top7 and a trusted ordinary-ASI gate capture. The server reads tasks/task_core_top7; other fields document the fixed protocol, not a generic config override API."
}
